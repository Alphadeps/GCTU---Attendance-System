// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  REP
  LECTURER
}

enum SessionType {
  PHYSICAL
  ONLINE
}

enum SessionStatus {
  OPEN
  CLOSED
  APPROVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id               String              @id @default(uuid())
  username         String              @unique
  indexNumber      String?             @unique // For REPs who login with index number
  password         String
  role             UserRole
  isActive         Boolean             @default(true)
  createdSessions  AttendanceSession[] @relation("RepSessions")
  approvedSessions AttendanceSession[] @relation("LecturerApprovedSessions")
  notifications    Notification[]
  assignedClass    Class?
  resolvedGrievances Grievance[]
  generatedReports OfficialReport[] @relation("RepGeneratedReports")
  signedReports    OfficialReport[] @relation("LecturerSignedReports")
  lecturerAssignments LecturerAssignment[] @relation("LecturerAssignments")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([username, role])
}

model Student {
  id                String         @id @default(uuid())
  indexNumber       String         @unique
  name              String
  email             String         @unique
  password          String?        // Null until first login
  isFirstLogin      Boolean        @default(true)
  deviceFingerprint String?
  attendances       Attendance[]
  classes           ClassStudent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([indexNumber])
  @@index([email])
  @@index([isFirstLogin])
}

model Course {
  id        String         @id @default(uuid())
  name      String         @unique
  code      String         @unique
  sessions  AttendanceSession[]
  classes   ClassCourse[]
  officialReports OfficialReport[]
  lecturerAssignments LecturerAssignment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AttendanceSession {
  id                 String            @id @default(uuid())
  courseId           String
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  repId              String
  rep                User              @relation("RepSessions", fields: [repId], references: [id])
  classId            String?
  class              Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionType        SessionType
  startTime          DateTime
  endTime            DateTime
  status             SessionStatus
  latitude           Float?
  longitude          Float?
  qrCode             String?
  qrCodeExpiry       DateTime?
  manualCode         String?
  networkSSID        String?
  attendances        Attendance[]
  lecturerSignature  String?
  approvedByLecturerId String?
  approvedByLecturer   User?             @relation("LecturerApprovedSessions", fields: [approvedByLecturerId], references: [id])
  approvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([courseId])
  @@index([repId])
  @@index([classId])
  @@index([status])
  @@index([startTime])
  @@index([approvedByLecturerId])
  @@index([courseId, classId, status])
  @@index([repId, status])
}

model Attendance {
  id           String           @id @default(uuid())
  sessionId    String
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkInTime  DateTime         @default(now())
  status       AttendanceStatus
  ipAddress    String?
  deviceInfo   String?
  locationData String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@index([checkInTime])
  @@index([sessionId, studentId])
  @@index([studentId, status])
}

model Notification {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentIndex String?  // Specific student targeted by index number
  title        String
  message      String
  type         String   // INFO, SUCCESS, WARNING, DANGER
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([studentIndex])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Programme {
  id          String   @id @default(uuid())
  name        String   @unique  // e.g. "BIT", "BSc CS"
  classes     Class[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Class {
  id           String    @id @default(uuid())
  programmeId  String
  programme    Programme @relation(fields: [programmeId], references: [id])
  level        String    // "100", "200", "300", "400"
  type         String    // "REGULAR", "TOP-UP"
  group        String    // "A" through "K"
  session      String    // "MORNING", "EVENING", "WEEKEND"
  displayName  String    // Auto-generated: "BIT LEVEL 300 TOP-UP GROUP B (EVENING)"
  repId        String?   @unique  // One rep per group
  rep          User?     @relation(fields: [repId], references: [id])
  students     ClassStudent[]
  courses      ClassCourse[]
  sessions     AttendanceSession[]
  officialReports OfficialReport[]
  lecturerAssignments LecturerAssignment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([programmeId, level, type, group, session])
  @@index([programmeId])
  @@index([level])
  @@index([repId])
  @@index([programmeId, level])
  @@index([level, type, session])
}

model ClassStudent {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model ClassCourse {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, courseId])
}

model SystemSettings {
  id                    String   @id @default(uuid())
  deptName              String   @default("Class Attendance System")
  deptLogoUrl           String?
  lateWindowMinutes     Int      @default(15)
  qrExpirySeconds       Int      @default(30)
  geofenceRadiusMeters  Int      @default(100)
  updatedAt             DateTime @updatedAt
}

model Grievance {
  id            String    @id @default(uuid())
  studentIndex  String?   // Store index if not anonymous
  studentName   String?   // Store name if not anonymous
  anonymous     Boolean   @default(false)
  type          String    // "ABSENCE_EXCUSE" | "SYSTEM_ISSUE" | "INTEGRITY_REPORT" | "GENERAL_COMPLAINT"
  subject       String
  message       String
  evidenceUrl   String?   // path to uploaded file
  status        String    @default("PENDING") // "PENDING" | "RESOLVED" | "REJECTED"
  adminResponse String?   // feedback from HOD/Admin
  resolvedById  String?
  resolvedBy    User?     @relation(fields: [resolvedById], references: [id])
  courseCode    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studentIndex])
  @@index([status])
  @@index([type])
  @@index([resolvedById])
  @@index([createdAt])
  @@index([status, type])
}

model ReportTemplate {
  id        String   @id @default(uuid())
  name      String   @default("Master Template")
  fileUrl   String   // path to the uploaded .docx file
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficialReport {
  id            String    @id @default(uuid())
  classId       String
  class         Class     @relation(fields: [classId], references: [id])
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  generatedById String
  generatedBy   User      @relation("RepGeneratedReports", fields: [generatedById], references: [id])
  fileUrl       String    // Path to the generated .docx
  status        String    @default("PENDING_SIGNATURE") // PENDING_SIGNATURE, SIGNED
  repSignature  String?   // Rep's signature (base64 or text)
  repSignedAt   DateTime?
  signedById    String?
  signedBy      User?     @relation("LecturerSignedReports", fields: [signedById], references: [id])
  lecturerSignature String? // Lecturer's signature (base64 or text)
  signedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([classId])
  @@index([courseId])
  @@index([generatedById])
  @@index([signedById])
  @@index([status])
  @@index([classId, courseId])
  @@index([status, createdAt])
}

model LecturerAssignment {
  id         String   @id @default(uuid())
  lecturerId String
  lecturer   User     @relation("LecturerAssignments", fields: [lecturerId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lecturerId, classId, courseId])
  @@index([lecturerId])
  @@index([classId])
  @@index([courseId])
  @@index([lecturerId, classId])
  @@index([classId, courseId])
}
