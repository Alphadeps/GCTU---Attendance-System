# Copy to .env for local development. On Render, set these under Environment.

# Database (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=postgresql://user:password@host-pooler/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# Signs every login. Required in production: 64+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First super admin, created on startup if missing
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Website address allowed to call the API (besides the built-in Vercel URL)
FRONTEND_URL=

# Optional: Redis (e.g. Upstash). Keeps rate limits and the attacker block list across restarts.
REDIS_URL=

# Optional: Cloudflare Turnstile bot check on sign-in, sign-up, join class and first password.
# Off while empty. The matching site key goes in the frontend as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# Optional: only accept tokens solved on these hostnames (comma-separated)
TURNSTILE_ALLOWED_HOSTNAMES=gctu-attendance-system-chi.vercel.app

# Optional: where security researchers report problems (shown in /.well-known/security.txt)
SECURITY_CONTACT=mailto:security@gctu.edu.gh
