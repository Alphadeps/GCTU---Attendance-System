# Copy to .env for local development. On Vercel, set these under Settings -> Environment Variables.

# Backend API address
VITE_API_URL=http://localhost:5000/api

# Optional: Cloudflare Turnstile site key (public). Off while empty.
# The matching secret goes in the backend as TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
